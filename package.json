{
  "name": "@next/env",
  "version": "15.5.18",
  "keywords": [
    "react",
    "next",
    "next.js",
    "dotenv"
  ],
  "description": "Next.js dotenv file loading",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/next.js",
    "directory": "packages/next-env"
  },
  "author": "Next.js Team <support@vercel.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "tsc": "npx -p typescript tsc",
    "dev": "ncc build ./index.ts -w -o dist/",
    "prerelease": "npx rimraf@4.4.1 ./dist/",
    "types": "yarn tsc index.ts --declaration --emitDeclarationOnly --declarationDir dist --esModuleInterop",
    "release": "ncc build ./index.ts -o ./dist/ --minify --no-cache --no-source-map-register",
    "build": "yarn release && yarn types",
    "prepublish": "yarn build"
  },
  "devDependencies": {
    "@types/node": "18.19.1",
    "@vercel/ncc": "0.34.0",
    "dotenv": "16.3.1",
    "dotenv-expand": "10.0.0",
    "typescript": "5.4.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
